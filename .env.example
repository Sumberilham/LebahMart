#Salin ke .env.local lalu isi dengan nilai acak panjang (>= 32 karakter).
# APP_SECRET : mengsign cookie sesi pelanggan (jangan dipakai ulang di tempat lain)
# GATEWAY_SECRET : kunci HMAC yang "dimiliki" mock gateway, TIDAK BOLEH pernah dikirim ke browser
APP_SECRET=
GATEWAY_SECRET=

#Set 1 hanya jika aplikasi berjalan di belakang reverse proxy yang menulis ulang
#x-forwarded-for / x-real-ip. Tanpa ini, pembedaan IP untuk rate limit dimatikan
#supaya header palsu dari klien tidak bisa dipakai lolos pembatasan.
TRUST_PROXY=0
